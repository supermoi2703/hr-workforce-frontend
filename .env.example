# Copy thành .env.local rồi sửa giá trị cho máy mình. Không commit .env.local.

# Địa chỉ backend Spring Boot mà Next.js chuyển tiếp /api/* tới (đọc lúc khởi động dev/build).
BACKEND_URL=http://localhost:8080

# Chế độ đăng nhập: "mock" = đăng nhập giả lập, đổi vai trò ngay trên header;
# "backend" = đăng nhập thật qua /api/auth (khi module auth phía frontend đã xong).
NEXT_PUBLIC_AUTH_MODE=mock
