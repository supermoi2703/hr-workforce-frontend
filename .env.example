# Copy thành .env.local rồi sửa giá trị cho máy mình. Không commit .env.local.
# Sửa xong phải chạy lại `npm run dev` (các biến chỉ được đọc lúc khởi động / build).

# Địa chỉ backend Spring Boot mà Next.js chuyển tiếp /api/* và /oauth2/* tới.
BACKEND_URL=http://localhost:8080

# Chế độ đăng nhập:
# - "backend": đăng nhập thật qua /api/auth (cần backend + Postgres + Redis đang chạy).
# - "mock": không cần backend, luôn coi như đã đăng nhập; đổi vai trò giả lập bằng nút "Role" trên header
#   để thử menu / phân quyền. Dùng khi chỉ làm giao diện.
NEXT_PUBLIC_AUTH_MODE=backend
